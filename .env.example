# Generate a unique secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key
DATABASE_URL=sqlite:///secure_login.db
# Set true only when serving behind HTTPS.
COOKIE_SECURE=false
